# Environment variables (never commit secrets)
.env

# Virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo

# Test / lint / format caches
.pytest_cache/
.ruff_cache/

# Generated project packages (Phase 6 create_project_zip / Download ZIP)
dist/

# Generated PDF documents (create_pdf / Download PDF)
generated_files/

# generated_projects/ (New Application Generation, Phase 6) is deliberately
# NOT ignored here - unlike dist/'s disposable build output, it holds the
# actual generated application source code, which is real, human-approved
# project content a user may want to track in their own repository.
# Its own runtime artifacts are not source, though - a live-preview server's
# stdout log and its small state file (used to reclaim/stop it even from a
# fresh assistant process - see tools.py's launch_generated_app) - so those
# are excluded the same way dist/ is.
generated_projects/*/.server.log
generated_projects/*/.server.state.json
generated_projects/*/*.db

# Streamlit (secrets only - config.toml holds the app's theme, not secrets,
# and is tracked so the dark dashboard theme ships with the project)
.streamlit/*
!.streamlit/config.toml

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
