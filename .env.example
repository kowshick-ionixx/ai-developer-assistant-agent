# Copy this file to ".env" and paste in your real Google Gemini API key.
# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the Gemini model used by the agent.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional (Phase 4): enables web_search / documentation_search.
# Get a key from https://app.tavily.com
TAVILY_API_KEY=

# Optional (Phase 4): enables higher GitHub API rate limits and access to
# private repos for github_get_repository/github_get_issues/github_get_pull_requests.
# Without it, these tools still work anonymously for public repositories.
# Create a fine-grained, read-only token at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional (Phase 4): default "owner/repo" used by the GitHub tools when the
# user doesn't specify one, e.g. GITHUB_REPO=anthropics/claude-code
GITHUB_REPO=
